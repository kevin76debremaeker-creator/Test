ANTHROPIC_API_KEY=your-api-key-here

# --- Kapperszaak-planner / Google Agenda ---
# ID van de agenda waarin afspraken komen (te vinden in Agenda-instellingen).
# Vaak het Google-account-e-mailadres van de zaak, of een speciaal agenda-ID.
GOOGLE_CALENDAR_ID=jouw-agenda-id@group.calendar.google.com
# Pad naar het service-account JSON-sleutelbestand (zie SETUP_GOOGLE_AGENDA.md).
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Tijdzone voor de afspraken.
TIMEZONE=Europe/Amsterdam
# Poort voor de webserver (optioneel).
PORT=5000
